1 1 1 90 90 90     # conventional unit cell (a,b,c,alpha,beta,gamma); a,b,c scaled by line 3
0 0.5 0.5 0.5 0 0.5 0.5 0.5 0  # primitive vectors R01,R02,R03 in units of the conventional cell
5.7022565          # scaling factor for the lattice parameters (Ang)
1 1 1 0 0 0 0 0    # 0 to exclude and 1 to include this rank (r=1,...,8) in the fitting
1 1 0 0            # impose invariances: translational, rotational, Huang, exact enforcement
0 300              # itemp (0=no Boltzmann weighting of snapshots), tempk (K)
1 .false.          # number of POSCARi/FORCEDISPi file pairs, verbosity
1                  # number of atom types
72.64              # mass of each atom type (uma)
Ge                 # name of each atom type
2                  # total number of atoms in the primitive cell
0                  # fc2range: 0 = default FC2 range dictated by the supercell, 1 = use line 13
11 11              # number of shells for harmonic (rank 2) FCs, one per atom of the prim. cell
3 3                # number of shells for cubic (rank 3) FCs
0 0                # number of shells for quartic (rank 4) FCs
0 0                # number of shells for rank 5 FCs
0 0                # number of shells for rank 6 FCs
0 0                # number of shells for rank 7 FCs
0 0                # number of shells for rank 8 FCs
1 1 0 0 0          # atom number, atom type, coordinates in units of CONVENTIONAL vectors
2 1 0.25 0.25 0.25 # atom number, atom type, coordinates in units of CONVENTIONAL vectors
