4 4 4        # kmesh (n1,n2,n3) along each reciprocal vector for Brillouin zone summations
0 0 0  1 0 0 # shift of the above kpoint grid (fractions of a mesh step); normal to the surface
300 350.0    # number of frequency points for the DOS, omega_max (1/cm)
10           # width of the gaussian broadening for the DOS (1/cm)
.False.      # read but not used (verbosity is set in structure.params)
0 900        # Tmin(K), Tmax(K) for the thermodynamic properties
0            # 0 for quantum (Bose-Einstein) occupations, 1 for classical (kT/hbar.omega)
